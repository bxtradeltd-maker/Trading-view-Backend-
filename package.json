{
  "name": "trading-platform",
  "version": "0.1.0",
  "private": true,
  "description": "TradingView -> Deriv automated trading platform. See docs/adr, PHASES.md, ADR.md for governance.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "dev": "npm run dev --workspace=apps/api",
    "start": "npm run start --workspace=apps/api",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --build --dry"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "@vitest/coverage-v8": "^2.0.5",
    "@types/node": "^20.14.0"
  }
}
